# Canonical PUBLIC build environment for verifiable production builds.
# Every value here is public by definition — it ships inside the browser
# bundle. Secrets must never appear in this file (a frontend bundle cannot
# keep a secret anyway).
#
# This file is the single source of truth for what a verifiable Homebase
# build talks to. Changing any value changes the build hash.
REACT_APP_ENV=PROD
REACT_APP_NETWORK=mainnet
REACT_APP_URL=https://tezos-homebase.io
REACT_APP_V2_URL=https://v2.tezos-homebase.io
REACT_APP_HASURA_URL=https://v3-homebase-indexer.tezos-homebase.io/v1/graphql
REACT_APP_HASURA_URL_V2=https://v2-homebase-indexer.w3api.dev/v1/graphql
REACT_APP_LITE_API_URL=https://homebase-backend.netlify.app
REACT_APP_DAO_DEPLOYER_API=https://homebase-dao-deployer.tezos-homebase.io
REACT_APP_BASEDAO_DOCKERISED_URL=https://v3-basedao-dockerised.herokuapp.com/steps
REACT_APP_CORS_PROXY_URL=https://dorg-cors-proxy.herokuapp.com
REACT_APP_POSTHOG_KEY=phc_o6mUWsxRDEbXyHLuyCfkAploVj0azEyV64DGlF7fvqd
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com
REACT_APP_IS_NOT_TESTING=true
REACT_APP_IGNORE_DAO_CYCLE_CHECK=false
